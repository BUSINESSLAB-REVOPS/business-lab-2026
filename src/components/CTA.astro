---
import Background from './Background.astro';
interface Props {
  title?: string;
  description?: string;
  label?: string;
  href?: string;
  id?: string;
  backgroundImage?: string;
}
const {
  title = '¿Listo para escalar tus ventas con un sistema real y accesible?',
  description = 'En Business Lab combinamos lo mejor de la estrategia, la ejecución y la tecnología para construir tu propio motor comercial.',
  label = 'Consultoria Gratuita',
  href = '/#contacto',
  id,
  backgroundImage = '/assets/CONSULTORIA-GRATUITA.jpg',
} = Astro.props;
---

<section class="cta">
  <Background src={backgroundImage} />
  <div class="cta-container">
    <div class="cta-content">
      <h2 id={id}>{title}</h2>
      <p>{description}</p>
      <a class="cta-button" href={href}>
        {label}
      </a>
    </div>
  </div>
</section>
<style>
  @layer overrides {
    .cta {
      position: relative;
      padding: 64px 24px;
      background: var(--color-midnight);
      color: #fff;
      font: 16px/1.6 var(--font-body);
    }
    .cta-container {
      position: relative;
      z-index: 1;
      width: min(calc(100% - 48px), var(--container-width));
      max-width: var(--container-width);
      margin-inline: auto;
    }
    .cta-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
      padding: 10px;
      margin: 20px auto;
      width: 100%;
      max-width: 820px;
      text-align: center;
    }
    h2 {
      font: 700 36px/1.3 var(--font-heading);
      letter-spacing: -0.025em;
      color: inherit;
    }
    p {
      padding: 0;
      color: var(--color-on-dark);
      font-size: 18px;
      line-height: 1.6;
    }
    .cta-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 14px 28px;
      background: var(--color-primary);
      color: #fff;
      border-radius: var(--radius-button);
      font: 500 16px/1.5 var(--font-body);
      letter-spacing: -0.01em;
      transition:
        background-color 0.18s var(--ease-out),
        transform 0.16s var(--ease-out);
    }
    .cta-button:hover {
      background: var(--color-primary-hover);
      color: #fff;
      transform: translateY(-1px);
    }
    @media (max-width: 767px) {
      .cta {
        padding: 48px 20px;
      }
      .cta-container {
        width: 100%;
      }
      h2 {
        font-size: 26px;
      }
      p {
        font-size: 15px;
      }
      .cta-button {
        font-size: 15px;
        padding: 12px 22px;
      }
    }
  }
</style>
