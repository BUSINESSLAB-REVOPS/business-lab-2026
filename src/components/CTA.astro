---
interface Props {
  title?: string;
  description?: string;
  label?: string;
  href?: string;
  id?: string;
  index?: number;
  backgroundImage?: string;
}

const {
  title = "¿Listo para escalar tus ventas con un sistema real y accesible?",
  description = "En Business Lab combinamos lo mejor de la estrategia, la ejecución y la tecnología para construir tu propio motor comercial.",
  label = "Consultoria Gratuita",
  href = "/#contacto",
  id,
  index = 1,
  backgroundImage = "/assets/CONSULTORIA-GRATUITA.jpg",
} = Astro.props;
---

<section
  class={`et_pb_fullwidth_header_${index} et_pb_fullwidth_header et_pb_bg_layout_dark et_pb_text_align_center et_pb_section_parallax et_pb_module et_flex_module`}
>
  <span class="et-pb-parallax-wrapper"
    ><span
      class={`et-pb-parallax-background et-pb-parallax-background-module--divi-fullwidth-header-${index}`}
      style={`background-image:url(${backgroundImage})`}></span></span
  >
  <div class="et_pb_fullwidth_header_container center">
    <div class="header-content-container center">
      <div class="header-content et_flex_module">
        <h1 class="et_pb_module_header" id={id}>{title}</h1>
        <div class="et_pb_header_content_wrapper"><p>{description}</p></div>
        <div class="et_pb_header_button_wrapper">
          <a class="et_pb_button et_pb_more_button et_pb_button_one" href={href}
            >{label}</a
          >
        </div>
      </div>
    </div>
  </div>
  <div class="et_pb_fullwidth_header_overlay"></div>
  <div class="et_pb_fullwidth_header_scroll"></div>
</section>
