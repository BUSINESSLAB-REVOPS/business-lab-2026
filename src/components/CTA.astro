---
import Background from './Background.astro';
interface Props {
  title?: string;
  description?: string;
  label?: string;
  href?: string;
  id?: string;
  backgroundImage?: string;
}
const {
  title = '¿Listo para escalar tus ventas con un sistema real y accesible?',
  description = 'En Business Lab combinamos lo mejor de la estrategia, la ejecución y la tecnología para construir tu propio motor comercial.',
  label = 'Consultoria Gratuita',
  href = '/#contacto',
  id,
  backgroundImage = '/assets/CONSULTORIA-GRATUITA.jpg',
} = Astro.props;
---

<section class="cta">
  <Background src={backgroundImage} />
  <div class="cta-container">
    <div class="cta-content">
      <h2 id={id}>{title}</h2>
      <p>{description}</p>
      <a class="cta-button" href={href}>
        {label}
      </a>
    </div>
  </div>
</section>
<style>
  @layer overrides {
    .cta {
      position: relative;
      padding: 50px 0;
      background: var(--color-orange);
      color: #fff;
      font: 18px/1.4em var(--font-body);
    }
    .cta-container {
      position: relative;
      z-index: 1;
      width: 80%;
      max-width: 1080px;
      margin-inline: auto;
    }
    .cta-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
      padding: 10px;
      margin: 20px auto;
      width: 80%;
      max-width: 100%;
      text-align: center;
    }
    h2 {
      font: 600 32px/1.2 var(--font-heading);
      color: inherit;
    }
    p {
      padding: 0;
    }
    .cta-button {
      display: inline-block;
      margin-right: 15px;
      padding: 0.3em 1em;
      background: var(--color-orange);
      color: #fff;
      border-radius: 12px;
      font: 500 20px/1.7 var(--font-body);
    }
    @media (max-width: 767px) {
      h2 {
        font-size: 25px;
      }
      p {
        font-size: 14px;
      }
      .cta-button {
        font-size: 16px;
      }
    }
  }
</style>
