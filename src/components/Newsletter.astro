<form class="newsletter" id="newsletter-form">
  <h2>Suscríbete a nuestro blog</h2>
  <label class="visually-hidden" for="newsletter-email"
    >Correo Electrónico</label
  >
  <input
    id="newsletter-email"
    name="email"
    type="email"
    autocomplete="email"
    placeholder="Correo Electrónico"
    required
  />
  <button class="button newsletter-button" type="submit"
    >Suscríbete <span aria-hidden="true">→</span></button
  >
  <p class="newsletter-note">Solicita tu suscripción por correo electrónico.</p>
  <p id="newsletter-status" class="newsletter-status" role="status"></p>
  <a id="newsletter-mail" class="newsletter-mail" hidden
    >Enviar solicitud por correo →</a
  >
</form>
<script>
  document
    .querySelector<HTMLFormElement>("#newsletter-form")
    ?.addEventListener("submit", (event) => {
      event.preventDefault();
      const email =
        document.querySelector<HTMLInputElement>("#newsletter-email");
      const link =
        document.querySelector<HTMLAnchorElement>("#newsletter-mail");
      const status = document.querySelector<HTMLElement>("#newsletter-status");
      if (!email?.reportValidity() || !link || !status) return;
      const body = `Hola, quiero suscribirme al blog de Business Lab con el correo ${email.value}.`;
      link.href = `mailto:eduardomz@business-lab.net?subject=${encodeURIComponent("Solicitud de suscripción al blog")}&body=${encodeURIComponent(body)}`;
      link.hidden = false;
      status.textContent =
        "Tu suscripción aún no se ha enviado. Abre tu aplicación de correo y envía la solicitud:";
    });
</script>
