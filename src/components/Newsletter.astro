<form
  action="mailto:eduardomz@business-lab.net?subject=Solicitud%20de%20suscripcion"
  method="post"
  enctype="text/plain"
  class="newsletter"
  id="newsletter-form"
>
  <h2>Suscríbete a nuestro blog</h2>
  <label class="visually-hidden" for="newsletter-email">
    Correo Electrónico
  </label>
  <input
    id="newsletter-email"
    name="email"
    type="email"
    autocomplete="email"
    placeholder="Correo Electrónico"
    required
  />
  <button class="button newsletter-button" type="submit">
    Suscríbete <span aria-hidden="true">→</span>
  </button>
  <p class="newsletter-note">Solicita tu suscripción por correo electrónico.</p>
  <p id="newsletter-status" class="newsletter-status" role="status"></p>
  <a id="newsletter-mail" class="newsletter-mail" hidden>
    Enviar solicitud por correo →
  </a>
  <noscript>
    <p class="newsletter-note">
      <a href="mailto:eduardomz@business-lab.net?subject=Solicitud%20de%20suscripcion">
        Solicitar suscripción por correo
      </a>
    </p>
  </noscript>
</form>
<script>
  document
    .querySelector<HTMLFormElement>('#newsletter-form')
    ?.addEventListener('submit', (event) => {
      event.preventDefault();
      const email =
        document.querySelector<HTMLInputElement>('#newsletter-email');
      const link =
        document.querySelector<HTMLAnchorElement>('#newsletter-mail');
      const status = document.querySelector<HTMLElement>('#newsletter-status');
      if (!email?.reportValidity() || !link || !status) return;
      const body = `Hola, quiero suscribirme al blog de Business Lab con el correo ${email.value}.`;
      link.href = `mailto:eduardomz@business-lab.net?subject=${encodeURIComponent('Solicitud de suscripción al blog')}&body=${encodeURIComponent(body)}`;
      link.hidden = false;
      status.textContent =
        'Tu suscripción aún no se ha enviado. Abre tu aplicación de correo y envía la solicitud:';
    });
</script>

<style>
  @layer components {
    .newsletter {
      background: var(--color-blue);
      padding: 25px;
      border-radius: 16px;
    }
    .newsletter h2 {
      font-size: 22px;
      font-weight: 500;
      line-height: 1.3;
      margin: 0 0 20px;
    }
    .newsletter input {
      width: 100%;
      min-width: 0;
      background: #fff;
      color: #333;
      border: 1px solid #ddd;
      border-radius: 3px;
      padding: 13px 15px;
      font-size: 15px;
    }
    .newsletter-button {
      margin-top: 15px;
      width: 100%;
      background: #d03535;
      border: 0;
      color: #fff;
      letter-spacing: 0;
      font-size: 14px;
      border-radius: 16px;
      padding: 6px 14px;
    }
    .newsletter-button span {
      font-size: 18px;
    }
    .newsletter-note,
    .newsletter-status {
      font-size: 11px;
      line-height: 1.6;
      color: #fff;
      margin-top: 12px;
    }
    .newsletter-status:empty {
      display: none;
    }
    .newsletter-mail {
      display: inline-block;
      font-size: 13px;
      margin-top: 8px;
      text-decoration: underline;
    }
    @media (max-width: 600px) {
      .newsletter {
        max-width: 420px;
      }
      .newsletter h2 {
        font-size: 21px;
      }
    }
  }
</style>
