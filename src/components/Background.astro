---
import AssetImage from './AssetImage.astro';
interface Props {
  src: string;
  class?: string;
  style?: string;
  priority?: boolean;
}
const { src, class: className, style, priority = false } = Astro.props;
---

<span class:list={['scene-image', className]} style={style} aria-hidden="true">
  <AssetImage
    src={src}
    alt=""
    sizes="100vw"
    loading={priority ? 'eager' : 'lazy'}
    priority={priority}
  />
</span>
<style>
  @layer overrides {
    .scene-image {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
    }
    .scene-image :global(picture) {
      display: contents;
    }
    .scene-image :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: inherit;
    }
  }
</style>
