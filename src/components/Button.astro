---
interface Props {
  href: string;
  class?: string;
  arrow?: boolean;
}
const { href, class: className, arrow = false } = Astro.props;
---

<a href={href} class:list={['action-link', className, { 'has-arrow': arrow }]}>
  <slot />
  <svg class="action-arrow" aria-hidden="true" viewBox="0 0 24 24">
    <path
      d="M4 12h16m-6-6 6 6-6 6"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    />
  </svg>
</a>
<style>
  @layer components {
    .action-link {
      position: relative;
      display: inline-block;
      padding: 0.3em 1em;
      border: 2px solid currentColor;
      border-radius: 3px;
      font-size: 20px;
      line-height: 1.7;
      transition:
        padding 0.2s,
        background 0.2s;
    }
    .action-arrow {
      position: absolute;
      top: 50%;
      right: 0.25em;
      width: 1em;
      height: 1em;
      transform: translateY(-50%);
      opacity: 0;
    }
    .action-link:hover {
      padding-right: 1.8em;
    }
    .action-link:hover .action-arrow {
      opacity: 1;
    }
    .has-arrow .action-arrow {
      opacity: 1;
      color: var(--color-blue);
    }
  }
</style>
