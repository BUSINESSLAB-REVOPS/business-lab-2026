---
interface Props {
  href: string;
  class?: string;
  arrow?: boolean;
}
const { href, class: className, arrow = false } = Astro.props;
---

<a href={href} class:list={['action-link', className, { 'has-arrow': arrow }]}>
  <slot />
  <svg class="action-arrow" aria-hidden="true" viewBox="0 0 24 24">
    <path
      d="M4 12h16m-6-6 6 6-6 6"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    />
  </svg>
</a>
<style>
  @layer components {
    .action-link {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 10px 22px;
      border: 1.5px solid currentColor;
      border-radius: var(--radius-button);
      font-size: 16px;
      font-weight: 500;
      line-height: 1.5;
      letter-spacing: -0.01em;
      transition:
        background-color 0.2s var(--ease-out),
        border-color 0.2s var(--ease-out),
        color 0.2s var(--ease-out);
    }
    .action-arrow {
      position: absolute;
      top: 50%;
      right: 0.5em;
      width: 1em;
      height: 1em;
      transform: translateY(-50%);
      opacity: 0;
      transition:
        opacity 0.2s var(--ease-out),
        transform 0.2s var(--ease-out);
    }
    .action-link:hover .action-arrow {
      opacity: 1;
      transform: translate(2px, -50%);
    }
    .has-arrow .action-arrow {
      opacity: 1;
      color: var(--color-primary);
    }
  }
</style>
