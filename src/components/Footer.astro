---
import AssetImage from './AssetImage.astro';
import Newsletter from './Newsletter.astro';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-contact">
      <a href="/" aria-label="Business Lab, inicio">
        <AssetImage
          src="/assets/BL-LOGO-BLACK-LABEL-short.png"
          alt="Business Lab"
          sizes="230px"
        />
      </a>
      <address>
        <p>Alicante, España</p>
        <p>
          <a href="tel:+34652947264">+34 652 94 72 64</a>
        </p>
        <p>
          <a href="mailto:eduardomz@business-lab.net">
            eduardomz@business-lab.net
          </a>
        </p>
      </address>
    </div>
    <Newsletter />
    <nav class="footer-links" aria-label="Información y contacto">
      <a href="mailto:eduardomz@business-lab.net?subject=Trabaja%20con%20nosotros">
        Trabaja con nosotros →
      </a>
      <a href="mailto:eduardomz@business-lab.net?subject=Solicitud%20de%20politica%20de%20privacidad">
        Política privacidad →
      </a>
      <a href="mailto:eduardomz@business-lab.net?subject=Solicitud%20de%20politica%20de%20cookies">
        Política de cookies →
      </a>
      <a href="mailto:eduardomz@business-lab.net?subject=Solicitud%20de%20aviso%20legal">
        Aviso Legal →
      </a>
    </nav>
  </div>
</footer>

<style>
  @layer components {
    .site-footer {
      background: var(--color-black);
      color: #fff;
      padding: 50px 0;
    }
    .footer-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 5.5%;
      align-items: start;
    }
    .footer-contact :global(img) {
      width: 75%;
      max-width: 225px;
      margin: 0 0 27px;
    }
    .footer-contact address {
      font-style: normal;
      font-size: 14px;
      line-height: 1.8;
      overflow-wrap: anywhere;
    }
    .footer-contact address p + p {
      margin-top: 10px;
    }
    .site-footer a:hover {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
    .footer-links {
      display: flex;
      flex-direction: column;
      gap: 23px;
      font-size: 14px;
      line-height: 1.5;
    }
    @media (max-width: 1050px) {
      .footer-grid {
        grid-template-columns: 1fr 1fr;
        gap: 40px;
      }
      .footer-links {
        grid-column: 1/-1;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 20px 30px;
      }
    }
    @media (max-width: 600px) {
      .footer-grid {
        grid-template-columns: 1fr;
      }
      .footer-links {
        flex-direction: column;
        gap: 18px;
      }
    }
  }
</style>
