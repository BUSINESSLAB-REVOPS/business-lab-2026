          style=";--columns:3"
        >
          <div class="column-31 content-column flex-column column-24-24 column-24-24-tablet column-24-24-phone">
            <div
              class="content-block benefit-card flipbox-0"
              tabindex="0"
              role="group"
              aria-label="Ventas predecibles, no esporádicas"
            >
              <div class="module-inner">
                <div class="benefit-wrapper layout1">
                  <div class="benefit-side benefit-front flipbox_position_top flipbox_content_center">
                    <div class="benefit-inner">
                      <div class="benefit-front-content">
                        <div class="benefit-heading">
