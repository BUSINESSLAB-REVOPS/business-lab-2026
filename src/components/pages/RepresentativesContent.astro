---
import Section from '../Section.astro';
import Carousel from '../Carousel.astro';
import Slide from '../Slide.astro';
import Background from '../Background.astro';
import Button from '../Button.astro';
import CTA from '../CTA.astro';
import '../../styles/pages/sectores-representantes.css';
---

<div class="page-content page-sectores-representantes">
  <Section class="section-5 page-section fullwidth-section regular-section flex-section">
    <Carousel
      class="fullwidth-slider-1 carousel content-block"
      autoplay={true}
      label="Presentación"
    >
      <Slide class="slide-1 carousel-slide tone-dark with-background">
        <span class="scene-layer">
          <Background
            src="/assets/Slide2.jpg"
            class="scene-image background-slide-1"
            priority={true}
          />
        </span>
        <div class="slide-container">
          <div class="slide-inner">
            <div class="slide-description stack">
              <h1 class="slide-title heading-size-2">
                Representantes de marcas
              </h1>
              <div class="slide-content">
                <p>
                  Descubre como te podemos ayudar a multiplicar tu alcance
                  comercial con BL
                </p>
              </div>
              <div class="action-wrapper">
                <Button href="/#contacto" class="action-link slide-link">
                  AGENDA UNA REUNIÓN
                </Button>
              </div>
            </div>
          </div>
        </div>
      </Slide>
    </Carousel>
  </Section>
  <Section class="section-6 page-section regular-section flex-section">
    <div class="row-3 content-row flex-row" style=";--columns:2">
      <div class="column-7 content-column flex-column column-empty column-24-24 column-24-24-tablet column-24-24-phone"></div>
      <div class="column-8 content-column last-column flex-column column-empty column-24-24 column-24-24-tablet column-24-24-phone"></div>
    </div>
  </Section>
  <Section class="section-7 page-section regular-section flex-section">
    <div class="row-4 content-row flex-row" style=";--columns:2">
      <div class="column-9 content-column flex-column column-empty column-24-24 column-24-24-tablet column-24-24-phone"></div>
      <div class="column-10 content-column last-column flex-column column-empty column-24-24 column-24-24-tablet column-24-24-phone"></div>
    </div>
  </Section>
  <Section class="section-8 page-section fullwidth-section regular-section flex-section">
    <CTA />
  </Section>
</div>
