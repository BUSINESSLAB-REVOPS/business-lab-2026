---
import Section from '../Section.astro';
import Carousel from '../Carousel.astro';
import Slide from '../Slide.astro';
import Button from '../Button.astro';
import ArticleScroller from '../ArticleScroller.astro';
import ArticleCard from '../ArticleCard.astro';
import CTA from '../CTA.astro';
import { articles } from '../../data/articles';
import '../../styles/pages/blog.css';
---

<div class="page-content page-blog">
  <Section class="section-4 page-section section-specialty flex-section">
    <div class="content-row row-3-4-1-4 flex-row" style=";--columns:2">
      <div class="column-6 content-column flex-column column-24-24 column-24-24-tablet column-24-24-phone column-single">
        <div class="row-inner-1 row-inner flex-row">
          <div class="column-inner-1 column-inner last-column flex-column">
            <Carousel
              class="post-slider-1 article-hero tone-dark carousel slider-fullwidth-off post-slider-image-background slider-with-overlay content-block stack"
              autoplay={false}
              label="Artículos destacados"
            >
              <Slide class="carousel-slide post-slide-25980791 tone-dark">
                <div class="slide-overlay-container"></div>
                <div class="slide-container clearfix">
                  <div class="slide-inner">
                    <div class="slide-description">
                      <h2
                        class="slide-title heading-size-2"
                        id="institucion-educativa"
                      >
                        <a href="https://business-lab.net/casos-uso/institucion-educativa/">
                          Institucion Educativa
                        </a>
                      </h2>
                      <div class="slide-content">
                        <div class="slide-content-body">
                          <p>
                            Revertir su caída de matrículas y modernizar su
                            gestión integral en solo 10 meses
                          </p>
                        </div>
                      </div>
                      <div class="action-wrapper">
                        <Button
                          href="https://business-lab.net/casos-uso/institucion-educativa/"
                          class="action-link slide-link"
                        >
                          Read More
                        </Button>
                      </div>
                    </div>
                  </div>
                </div>
              </Slide>
              <Slide class="carousel-slide post-slide-25980784 tone-dark">
                <div class="slide-overlay-container"></div>
                <div class="slide-container clearfix">
                  <div class="slide-inner">
                    <div class="slide-description">
                      <h2
                        class="slide-title heading-size-2"
                        id="5-senales-de-que-necesitas-una-maquina-comercial"
