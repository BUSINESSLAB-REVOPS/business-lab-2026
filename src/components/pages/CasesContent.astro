---
import Section from '../Section.astro';
import ArticleCard from '../ArticleCard.astro';
import ArticleScroller from '../ArticleScroller.astro';
import CTA from '../CTA.astro';
import { articles } from '../../data/articles';
import '../../styles/pages/casos.css';
---

<div class="page-content page-casos">
  <Section class="section-4 page-section regular-section block-section">
    <div class="row-3 content-row block-row" style=";--columns:1">
      <div class="column-5 content-column span-4-4 last-column block-column">
        <div class="heading-1 heading content-block block-module">
          <div class="heading-container">
            <h1 class="heading-title heading-size-1">Algunos casos de exito</h1>
          </div>
        </div>
        <div class="blog-2 post-list tone-light posts content-block">
          <div class="ajax-pagination-container">
            <div class="post-grid grid-module">
              <ArticleCard
                id="institucion-educativa"
                post={articles['institucion-educativa']}
                class="post-card post-id-25980791 clearfix blog-item-2-0"
                variant="featured"
                showMeta={true}
                showAuthor={false}
                label="Leer más"
              />
            </div>
            <div class="pagination clearfix">
              <div class="alignleft"></div>
              <div class="alignright"></div>
            </div>
          </div>
        </div>
        <ArticleScroller
          class="content-block article-module blog-slider-0"
          layout="layout2"
        >
          <ArticleCard
            post={articles['institucion-educativa']}
            class="article-card"
            variant="slider"
            showMeta={true}
            showAuthor={true}
            label="Read More"
          />
          <ArticleCard
            id="5-senales-de-que-necesitas-una-maquina-comercial"
            post={articles['5-senales-de-que-necesitas-una-maquina-comercial']}
            class="article-card"
            variant="slider"
            showMeta={true}
            showAuthor={true}
            label="Read More"
          />
          <ArticleCard
            post={
              articles[
                'como-la-inteligencia-artificial-esta-redefiniendo-el-marketing-digital-en-2025'
              ]
            }
            class="article-card"
            variant="slider"
            showMeta={true}
            showAuthor={true}
            label="Read More"
          />
          <ArticleCard
            id="guia-de-diagnostico-de-madurez-comercial"
            post={articles['guia-de-diagnostico-de-madurez-comercial']}
            class="article-card"
            variant="slider"
            showMeta={true}
            showAuthor={true}
            label="Read More"
          />
          <ArticleCard
            id="como-aplicamos-la-metodologia-revenue-factory"
            post={articles['como-aplicamos-la-metodologia-revenue-factory']}
            class="article-card"
            variant="slider"
            showMeta={true}
            showAuthor={true}
            label="Read More"
          />
          <ArticleCard
            id="como-escalar-tus-ventas-b2b-con-una-ecuacion"
            post={articles['como-escalar-tus-ventas-b2b-con-una-ecuacion']}
            class="article-card"
            variant="slider"
            showMeta={true}
            showAuthor={true}
            label="Read More"
          />
          <ArticleCard
            id="como-convertimos-la-venta-b2b-en-un-sistema-que-escala"
            post={
              articles['como-convertimos-la-venta-b2b-en-un-sistema-que-escala']
            }
            class="article-card"
            variant="slider"
            showMeta={true}
            showAuthor={true}
            label="Read More"
          />
          <ArticleCard
            id="te-quieren-volver-influencerguia-para-detectarlo-parte-2"
            post={articles['te-quieren-volver-influencer-guia-para-detectarlo']}
            class="article-card"
            variant="slider"
            showMeta={true}
            showAuthor={true}
            label="Read More"
          />
          <ArticleCard
            id="te-quieren-volver-influencer-pero-tu-vendes-a-empresas-parte-1"
            post={
              articles['te-quieren-volver-influencer-pero-tu-vendes-a-empresas']
            }
            class="article-card"
            variant="slider"
            showMeta={true}
            showAuthor={true}
            label="Read More"
          />
          <ArticleCard
            post={
              articles[
                'distinguir-entre-una-consultoria-real-y-un-analisis-express'
              ]
            }
            class="article-card"
            variant="slider"
            showMeta={true}
            showAuthor={true}
            label="Read More"
          />
        </ArticleScroller>
      </div>
    </div>
  </Section>
  <Section class="section-5 page-section regular-section block-section">
    <div class="row-4 content-row block-row" style=";--columns:1">
      <div class="column-6 content-column span-4-4 last-column block-column">
        <div class="blog-3 post-list tone-light posts content-block">
          <div class="entry">
            <h2 class="not-found-title heading-size-1">
              No Se Encontraron Resultados
            </h2>
            <p>
              No se pudo encontrar la página que solicitaste. Prueba a ajustar
              tu búsqueda o usa la navegación superior para localizar la
              entrada.
            </p>
          </div>
        </div>
      </div>
    </div>
  </Section>
  <Section class="section-6 page-section fullwidth-section regular-section block-section">
    <CTA />
  </Section>
</div>
