---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: string;
  alt: string;
  class?: string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  priority?: boolean;
}
const {
  src,
  alt,
  class: className,
  sizes = '(max-width: 767px) 86vw, (max-width: 980px) 80vw, 540px',
  loading = 'lazy',
  priority = false,
} = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/*',
  { eager: true },
);
const filename = src.split('/').at(-1)!;
const original = filename.replace(/-\d+x\d+(?=\.)/, '');
const image =
  images[`../assets/images/${original}`]?.default ||
  images[`../assets/images/${original.replace(/\.(jpg|png)$/, '-scaled.$1')}`]
    ?.default ||
  images[`../assets/images/${filename}`]?.default;
if (!image) throw new Error(`Image is not registered: ${src}`);
const widths = [
  ...new Set(
    [240, 480, 768, 1080, image.width].filter((width) => width <= image.width),
  ),
].sort((a, b) => a - b);
---

<Picture
  src={image}
  alt={alt}
  class={className}
  formats={['webp']}
  fallbackFormat={image.format === 'png' ? 'png' : 'jpg'}
  widths={widths}
  sizes={sizes}
  loading={loading}
  fetchpriority={priority ? 'high' : 'auto'}
/>
