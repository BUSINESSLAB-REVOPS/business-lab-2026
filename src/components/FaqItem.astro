---
interface Props {
  question: string;
  open?: boolean;
  class?: string;
}
const { question, open = false, class: className } = Astro.props;
---

<details class:list={['faq-item', className]} open={open}>
  <summary class="faq-question heading-size-5">{question}</summary>
  <div class="faq-answer">
    <slot />
  </div>
</details>
<style>
  @layer components {
    .faq-item {
      border: 1px solid var(--color-card-border);
      border-radius: var(--radius-card);
      padding: 20px 24px;
      background: var(--color-surface-subtle);
      transition:
        background-color 0.2s,
        border-color 0.2s,
        box-shadow 0.2s;
    }
    .faq-question {
      position: relative;
      padding-right: 28px;
      cursor: pointer;
      list-style: none;
      font-family: var(--font-heading);
      font-weight: 600;
      font-size: 18px;
      letter-spacing: -0.015em;
      color: var(--color-ink);
    }
    .faq-question::-webkit-details-marker {
      display: none;
    }
    .faq-question::after {
      content: '+';
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      font-family: var(--font-body);
      font-size: 22px;
      color: var(--color-primary);
    }
    .faq-item[open] .faq-question::after {
      content: '−';
    }
    .faq-answer {
      padding-top: 16px;
      font-size: 15px;
      line-height: 1.6;
      color: var(--color-text-muted);
    }
  }
</style>
<style>
  @layer overrides {
    .faq-item[open] {
      background: var(--color-white);
      border-color: var(--color-brand-border);
      box-shadow: var(--shadow-panel);
    }
    .faq-question {
      color: var(--color-ink);
    }
    .faq-item[open] .faq-question {
      color: var(--color-primary);
    }
  }
</style>
