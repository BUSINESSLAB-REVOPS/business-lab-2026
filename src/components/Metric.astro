---
interface Props {
  value: string;
  label: string;
  class?: string;
}
const { value, label, class: className } = Astro.props;
---

<div class:list={['metric text-center opacity-100', className]}>
  <div class="metric-value">
    <p>
      <span class="metric-number">{value}</span>
    </p>
  </div>
  <p class="metric-label heading-size-5">{label}</p>
</div>
<style>
  @layer components {
    .metric-value {
      font: 700 72px/1 var(--font-heading);
      letter-spacing: -0.04em;
      color: var(--color-primary);
    }
    .metric-label {
      font-family: var(--font-heading);
      font-size: 16px;
      font-weight: 500;
      letter-spacing: -0.01em;
      color: var(--color-text-muted);
    }
  }
</style>
