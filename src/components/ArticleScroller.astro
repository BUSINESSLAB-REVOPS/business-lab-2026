---
interface Props {
  class?: string;
  layout?: string;
}
const { class: className, layout = 'layout3' } = Astro.props;
---

<bl-articles
  class:list={['article-module', className]}
  role="region"
  aria-label="Artículos"
>
  <div class={layout}>
    <div class="article-track">
      <slot />
    </div>
  </div>
  <div class="article-controls" hidden>
    <button type="button" data-back aria-label="Artículos anteriores">
      ‹
    </button>
    <button type="button" data-forward aria-label="Artículos siguientes">
      ›
    </button>
  </div>
</bl-articles>
<script>
  class ArticleScroller extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready !== undefined) return;
      this.dataset.ready = '';
      const track = this.querySelector<HTMLElement>('.article-track')!;
      this.querySelector<HTMLElement>('.article-controls')!.hidden = false;
      for (const [selector, direction] of [
        ['[data-back]', -1],
        ['[data-forward]', 1],
      ] as const)
        this.querySelector(selector)?.addEventListener('click', () =>
          track.scrollBy({
            left: direction * (track.clientWidth + 15),
            behavior: matchMedia('(prefers-reduced-motion: reduce)').matches
              ? 'instant'
              : 'smooth',
          }),
        );
    }
  }
  if (!customElements.get('bl-articles'))
    customElements.define('bl-articles', ArticleScroller);
</script>
<style>
  @layer components {
    bl-articles {
      display: block;
      min-width: 0;
    }
    .article-track {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: calc((100% - 30px) / 3);
      gap: 15px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      align-items: stretch;
    }
    .article-track > :global(*) {
      min-width: 0;
      scroll-snap-align: start;
    }
    .article-controls {
      display: flex;
      justify-content: center;
      gap: 16px;
      margin-top: 16px;
    }
    .article-controls button {
      background: var(--color-white);
      border: 1px solid var(--color-border);
      color: var(--color-ink);
      font-family: var(--font-heading);
      font-size: 20px;
      width: 40px;
      height: 38px;
      border-radius: var(--radius-button);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-shadow: var(--shadow-panel);
      transition:
        background-color 0.18s,
        border-color 0.18s,
        color 0.18s;
    }
    .article-controls button:hover {
      background: var(--color-brand-tint);
      border-color: var(--color-brand-border);
      color: var(--color-primary);
    }
    @media (max-width: 980px) {
      .article-track {
        grid-auto-columns: calc((100% - 15px) / 2);
      }
    }
    @media (max-width: 767px) {
      .article-track {
        grid-auto-columns: 100%;
      }
    }
  }
</style>
