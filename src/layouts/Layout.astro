---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Nosotros - Business Lab', description = 'Business Lab es la fusión de la estrategia y la ejecución para ayudar a escalar a las empresas tecnológicas.' } = Astro.props;
const navigation = [['Nosotros', '/'], ['Metodologia', '/metodologia/'], ['FAQs', '/nosotros/faqs/'], ['Consultoria Agil', '/consultoriaagil/'], ['Entrenamiento', '/servicios/entrenamiento/'], ['Casos', '/casos/'], ['Blog', '/blog/']];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Business Lab, inicio"><img src="/assets/BL-LOGO-White.jpg" alt="Business Lab" width="1140" height="256" /></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation" aria-label="Abrir menú"><span></span><span></span><span></span></button>
        <nav id="main-navigation" class="main-navigation" aria-label="Navegación principal">
          <ul>{navigation.map(([label, href]) => <li><a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a></li>)}</ul>
        </nav>
      </div>
    </header>
    <main id="contenido"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-contact">
          <a href="/" aria-label="Business Lab, inicio"><img src="/assets/BL-LOGO-BLACK-LABEL-short.png" alt="Business Lab" width="1266" height="313" loading="lazy" /></a>
          <address><p>Alicante, España</p><p><a href="tel:+34652947264">+34 652 94 72 64</a></p><p><a href="mailto:eduardomz@business-lab.net">eduardomz@business-lab.net</a></p></address>
        </div>
        <form class="newsletter" id="newsletter-form">
          <h2>Suscríbete a nuestro blog</h2>
          <label class="visually-hidden" for="newsletter-email">Correo Electrónico</label>
          <input id="newsletter-email" name="email" type="email" autocomplete="email" placeholder="Correo Electrónico" required />
          <button class="button newsletter-button" type="submit">Suscríbete <span aria-hidden="true">→</span></button>
          <p class="newsletter-note">Solicita tu suscripción por correo electrónico.</p>
          <p id="newsletter-status" class="newsletter-status" role="status"></p>
          <a id="newsletter-mail" class="newsletter-mail" hidden>Enviar solicitud por correo →</a>
        </form>
        <nav class="footer-links" aria-label="Información y contacto">
          <a href="mailto:eduardomz@business-lab.net?subject=Trabaja%20con%20nosotros">Trabaja con nosotros →</a>
          <a href="mailto:eduardomz@business-lab.net?subject=Solicitud%20de%20politica%20de%20privacidad">Política privacidad →</a>
          <a href="mailto:eduardomz@business-lab.net?subject=Solicitud%20de%20politica%20de%20cookies">Política de cookies →</a>
          <a href="mailto:eduardomz@business-lab.net?subject=Solicitud%20de%20aviso%20legal">Aviso Legal →</a>
        </nav>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>('.main-navigation');
      const closeMenu = () => { toggle?.setAttribute('aria-expanded', 'false'); navigation?.classList.remove('is-open'); toggle?.setAttribute('aria-label', 'Abrir menú'); };
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
        navigation?.classList.toggle('is-open', open);
      });
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { closeMenu(); toggle.focus(); } });
      navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      document.querySelector<HTMLFormElement>('#newsletter-form')?.addEventListener('submit', (event) => {
        event.preventDefault();
        const email = document.querySelector<HTMLInputElement>('#newsletter-email');
        const link = document.querySelector<HTMLAnchorElement>('#newsletter-mail');
        const status = document.querySelector<HTMLElement>('#newsletter-status');
        if (!email?.reportValidity() || !link || !status) return;
        const body = `Hola, quiero suscribirme al blog de Business Lab con el correo ${email.value}.`;
        link.href = `mailto:eduardomz@business-lab.net?subject=${encodeURIComponent('Solicitud de suscripción al blog')}&body=${encodeURIComponent(body)}`;
        link.hidden = false;
        status.textContent = 'Tu suscripción aún no se ha enviado. Abre tu aplicación de correo y envía la solicitud:';
      });
    </script>
  </body>
</html>
