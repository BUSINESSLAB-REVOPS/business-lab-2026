{
  "name": "business-lab",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && npm run build:fixture && playwright test",
    "capture:reference": "node scripts/capture-reference.mjs",
    "build:fixture": "astro build --root tests/fixtures/cta",
    "test:browser": "playwright test",
    "test:dev": "playwright test --config playwright.dev.config.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "intl-tel-input": "^29.5.10",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  }
}
